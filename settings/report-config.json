    {
      "id": "each_report_heading",
      "type": "component",
      "component": "SettingsSection",
      "readonly": true,
      "params": {
        "title": "Each report",
        "description": "Switch each report on, choose how often it runs, and add anyone who should get only that report."
      }
    },
    {
      "type": "field_group",
      "label": "Sales",
      "description": "Revenue, orders, top products and the day-by-day picture.",
      "fields": [
        {
          "id": "sales_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Send the sales report",
          "default": true
        },
        {
          "id": "period",
          "type": "select",
          "label": "Reporting period",
          "description": "Daily arrives every day, weekly every Monday, every 2 weeks on alternate Mondays, monthly on the 1st — at the Send at time above.",
          "default": "weekly",
          "options": [
            {
              "label": "Daily (previous day)",
              "value": "daily"
            },
            {
              "label": "Weekly (last 7 days)",
              "value": "weekly"
            },
            {
              "label": "Every 2 weeks (last 14 days)",
              "value": "biweekly"
            },
            {
              "label": "Monthly (previous calendar month)",
              "value": "monthly"
            }
          ]
        },
        {
          "id": "sales_recipients",
          "type": "tags",
          "label": "Also send this report to",
          "description": "These addresses get only the sales report, in addition to the main recipients list.",
          "placeholder": "name@example.com"
        },
        {
          "id": "top_products_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Include top products",
          "description": "Lists the 10 products that earned the most. The report shows 5, with Show more for the rest; the email lists 5. Turn off to leave the list out of the report and email.",
          "default": true
        },
        {
          "id": "include_daily_breakdown",
          "type": "boolean",
          "ui": "toggle",
          "label": "Include daily breakdown",
          "description": "Adds a day-by-day table of orders and revenue.",
          "default": true
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Customers",
      "description": "Customers who bought, new versus returning, repeat buyers, and your top customers by spend.",
      "fields": [
        {
          "id": "customers_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Send the customer report",
          "default": false
        },
        {
          "id": "customers_period",
          "type": "select",
          "label": "Reporting period",
          "default": "weekly",
          "options": [
            {
              "label": "Daily (previous day)",
              "value": "daily"
            },
            {
              "label": "Weekly (last 7 days)",
              "value": "weekly"
            },
            {
              "label": "Every 2 weeks (last 14 days)",
              "value": "biweekly"
            },
            {
              "label": "Monthly (previous calendar month)",
              "value": "monthly"
            }
          ]
        },
        {
          "id": "customers_recipients",
          "type": "tags",
          "label": "Also send this report to",
          "description": "These addresses get only the customer report, in addition to the main recipients list.",
          "placeholder": "name@example.com"
        },
        {
          "id": "top_customers_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Include top customers",
          "description": "Lists the 10 customers who spent the most. The report shows 5, with Show more for the rest; the email lists 5. Turn off to leave customer names out of the report and email.",
          "default": true
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Inventory",
      "description": "What is out of stock or running low, and how many days the remaining stock will last at the last 30 days' rate of sale.",
      "fields": [
        {
          "id": "inventory_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Send the inventory report",
          "default": false
        },
        {
          "id": "inventory_period",
          "type": "select",
          "label": "How often",
          "default": "weekly",
          "options": [
            {
              "label": "Daily",
              "value": "daily"
            },
            {
              "label": "Weekly (Mondays)",
              "value": "weekly"
            },
            {
              "label": "Every 2 weeks (alternate Mondays)",
              "value": "biweekly"
            },
            {
              "label": "Monthly (the 1st)",
              "value": "monthly"
            }
          ]
        },
        {
          "id": "inventory_recipients",
          "type": "tags",
          "label": "Also send this report to",
          "description": "These addresses get only the inventory report, in addition to the main recipients list.",
          "placeholder": "name@example.com"
        },
        {
          "id": "low_stock_threshold",
          "type": "number",
          "label": "Low stock threshold",
          "description": "Stock-tracked products and variants at or below this level are listed as low. Each report lists up to 50 out-of-stock and low items.",
          "default": 5,
          "min": 0,
          "max": 1000
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Products",
      "description": "Best and slowest sellers, the biggest movers against the previous period, and products that did not sell.",
      "fields": [
        {
          "id": "products_enabled",
          "type": "boolean",
          "ui": "toggle",
          "label": "Send the product report",
          "default": false
        },
        {
          "id": "products_period",
          "type": "select",
          "label": "Reporting period",
          "default": "weekly",
          "options": [
            {
              "label": "Daily (previous day)",
              "value": "daily"
            },
            {
              "label": "Weekly (last 7 days)",
              "value": "weekly"
            },
            {
              "label": "Every 2 weeks (last 14 days)",
              "value": "biweekly"
            },
            {
              "label": "Monthly (previous calendar month)",
              "value": "monthly"
            }
          ]
        },
        {
          "id": "products_recipients",
          "type": "tags",
          "label": "Also send this report to",
          "description": "These addresses get only the product report, in addition to the main recipients list.",
          "placeholder": "name@example.com"
        },
        {
          "id": "include_unsold_products",
          "type": "boolean",
          "ui": "toggle",
          "label": "List products with no sales",
          "description": "Active products, older than the period, that sold nothing in it.",
          "default": true
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Discounts",
      "description": "How much was discounted, through which coupons and promotions, and the revenue those orders brought in.",
