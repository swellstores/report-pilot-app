{
  "$schema": "https://json.swell.store/setting.json",
  "label": "Reports",
  "description": "Choose which reports are emailed, how often each one runs, and who receives them.",
  "actions": [
    {
      "id": "send_now",
      "label": "Send a report now",
      "function": "send-report-now",
      "hint": "Generate a report and email it right away, without waiting for its schedule.",
      "loading_label": "Sending…",
      "modal": {
        "title": "Send a report now",
        "description": "Each report covers its most recent full period: the previous day, the 7 or 14 days before today, or the previous calendar month. The inventory report shows stock as it is now. It goes to the recipients for that report.",
        "submit_label": "Send",
        "fields": [
          {
            "id": "report_type",
            "type": "select",
            "label": "Report",
            "default": "sales",
            "required": true,
            "options": [
              {
                "label": "Sales",
                "value": "sales"
              },
              {
                "label": "Customers",
                "value": "customers"
              },
              {
                "label": "Inventory",
                "value": "inventory"
              },
              {
                "label": "Products",
                "value": "products"
              },
              {
                "label": "Discounts",
                "value": "discounts"
              },
              {
                "label": "Abandoned carts",
                "value": "carts"
              },
              {
                "label": "Subscriptions",
                "value": "subscriptions"
              }
            ]
          },
          {
            "id": "only_to",
            "type": "email",
            "label": "Send only to",
            "description": "Optional. Enter one address to send a test to just that address. Leave it empty to send to the report's recipients.",
            "placeholder": "name@example.com"
          }
        ]
      }
    }
  ],
  "fields": [
    {
      "id": "enabled",
      "type": "boolean",
      "ui": "toggle",
      "label": "Send scheduled reports",
      "description": "Master switch. Turn off to stop every scheduled report without uninstalling the app.",
      "default": true
    },
    {
      "id": "send_when_empty",
      "type": "boolean",
      "ui": "toggle",
      "label": "Send even when there is nothing to report",
      "description": "When off, a report is skipped if its period had nothing in it — no paid orders, no products sold, no discounted orders, no customers, no stock running low, no abandoned carts, or no subscription activity.",
      "default": false
    },
    {
      "id": "recipients",
      "type": "tags",
      "label": "Recipients",
      "description": "Email addresses that receive every report that is switched on. To send a report to someone else as well, add them under that report's tab. Leave both empty to keep reports in the dashboard without emailing anyone.",
      "placeholder": "finance@example.com"
    },
    {
      "type": "field_row",
