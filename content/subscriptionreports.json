{
  "$schema": "https://json.swell.store/content.json",
  "collection": "subscriptionreports",
  "label": "Subscription reports",
  "description": "Subscription activity for a single reporting period.",
  "fields": [
    {
      "id": "period_label",
      "label": "Period",
      "type": "text",
      "readonly": true,
      "description": "Human-readable label for the reporting period."
    },
    {
      "id": "period_start",
      "label": "Period start",
      "type": "datetime",
      "readonly": true,
      "description": "When the period starts (shown in your local time)."
    },
    {
      "id": "period_end",
      "label": "Period end",
      "type": "datetime",
      "readonly": true,
      "description": "When the period ends (shown in your local time)."
    },
    {
      "id": "currency",
      "label": "Currency",
      "type": "text",
      "readonly": true,
      "description": "Currency the amounts are reported in."
    },
    {
      "id": "active_count",
      "label": "Active",
      "type": "number",
      "readonly": true,
      "description": "Paying subscriptions when the report ran."
    },
    {
      "id": "monthly_recurring_revenue",
      "label": "Monthly revenue",
      "type": "currency",
      "readonly": true,
      "description": "What active subscriptions bring in per month."
    },
    {
      "id": "new_count",
      "label": "New",
      "type": "number",
      "readonly": true,
      "description": "Subscriptions started in this period."
    },
    {
      "id": "canceled_count",
      "label": "Canceled",
      "type": "number",
      "readonly": true,
      "description": "Subscriptions canceled in this period."
    },
    {
      "id": "net_change",
      "label": "Net",
      "type": "number",
      "readonly": true,
      "description": "New minus canceled."
    },
    {
      "id": "summary",
      "label": "Subscription report summary",
      "type": "component",
      "component": "ReportSummary",
      "readonly": true,
      "description": "Headline figures for this period. Hover the info icon on a figure for what it counts.",
      "params": {
        "note_key": "truncated",
        "note": "This store has more subscriptions than the report reads, so some figures and lists cover only part of them.",
        "rows": [
          [
            {
              "key": "active_count",
              "label": "Active subscriptions",
              "hint": "Paying subscriptions when the report ran. Trials, paused and past due are counted separately."
            },
            {
              "key": "monthly_recurring_revenue",
              "label": "Monthly recurring revenue",
              "type": "currency",
              "hint": "What active subscriptions bring in per month. Plans billed weekly, every few months or yearly are converted to a monthly amount."
            },
            {
              "key": "trial_count",
              "label": "On trial",
              "hint": "Subscriptions in a free trial when the report ran."
            }
          ],
          [
            {
              "key": "new_count",
              "label": "New subscriptions",
              "hint": "Subscriptions started in this period, including trials."
            },
            {
              "key": "new_change_pct",
              "label": "New change",
              "type": "change",
              "hint": "Percentage change in new subscriptions compared with the previous period."
            },
            {
              "key": "net_change",
              "label": "Net change",
              "hint": "New subscriptions minus canceled ones in this period."
            }
          ],
          [
            {
              "key": "canceled_count",
              "label": "Canceled",
              "hint": "Subscriptions canceled in this period."
            },
            {
              "key": "canceled_change_pct",
              "label": "Canceled change",
              "type": "change",
              "hint": "Percentage change in cancellations compared with the previous period.",
              "tone": "neutral"
            },
            {
              "key": "paused_count",
              "label": "Paused",
              "hint": "Subscriptions paused when the report ran."
            }
          ],
          [
            {
              "key": "past_due_count",
              "label": "Past due",
              "hint": "Subscriptions whose last renewal payment failed: past due while Swell retries, or unpaid once it stops."
            },
            {
              "key": "renewals_next_7_days",
              "label": "Renewals in the next 7 days",
              "hint": "Active subscriptions due to bill in the 7 days after this period."
            },
            {
              "key": "trials_ending_next_7_days",
              "label": "Trials ending in the next 7 days",
              "hint": "Free trials ending in the 7 days after this period."
            }
          ]
        ]
      }
    },
    {
      "id": "plans",
      "label": "By plan",
      "type": "component",
      "component": "ReportTable",
      "readonly": true,
      "description": "Running subscriptions by plan, highest monthly revenue first, up to 10.",
      "params": {
        "empty": "No subscriptions are running.",
        "columns": [
          {
            "key": "plan",
            "label": "Plan"
          },
          {
            "key": "paying",
            "label": "Paying",
            "type": "number"
          },
          {
            "key": "trial",
            "label": "On trial",
            "type": "number"
          },
          {
            "key": "monthly_revenue",
            "label": "Monthly revenue",
            "type": "currency"
          }
        ],
        "collapsed_rows": 5
      }
    },
    {
      "id": "canceled_subscriptions",
      "label": "Canceled subscriptions",
      "type": "component",
      "component": "ReportTable",
      "readonly": true,
      "description": "Subscriptions canceled in this period, highest monthly value first, up to 10. Click a name to open the customer.",
      "params": {
        "empty": "No subscriptions were canceled in this period.",
        "columns": [
          {
            "key": "customer",
            "label": "Customer",
            "type": "link",
            "href": "customers/{account_id}"
          },
          {
            "key": "plan",
            "label": "Plan"
          },
          {
            "key": "canceled_date",
            "label": "Canceled",
            "type": "date"
          },
          {
            "key": "monthly_value",
            "label": "Monthly value",
            "type": "currency"
          }
        ],
        "collapsed_rows": 5,
        "unlisted_key": "canceled_hidden",
        "unlisted_note": "{n} more canceled subscriptions were not listed. Each report lists up to 10."
      }
    },
    {
      "id": "past_due_subscriptions",
      "label": "Failed renewals",
      "type": "component",
      "component": "ReportTable",
      "readonly": true,
      "description": "Subscriptions whose renewal payment failed, largest amount first, up to 10.",
      "params": {
        "empty": "No renewal payments have failed.",
        "columns": [
          {
            "key": "customer",
            "label": "Customer",
            "type": "link",
            "href": "customers/{account_id}"
          },
          {
            "key": "plan",
            "label": "Plan"
          },
          {
            "key": "amount",
            "label": "Amount due",
            "type": "currency"
          },
          {
            "key": "status",
            "label": "Status",
            "values": {
              "pastdue": "Past due",
              "unpaid": "Unpaid"
            }
          }
        ],
        "collapsed_rows": 5,
        "unlisted_key": "past_due_hidden",
        "unlisted_note": "{n} more subscriptions with failed renewals were not listed. Each report lists up to 10."
      }
    },
    {
      "id": "truncated",
      "label": "Partial",
      "type": "boolean",
      "readonly": true,
      "description": "Set when a read hit its page ceiling, so counts are a lower bound."
    }
  ],
  "views": [
    {
      "id": "list",
      "label": "Subscription reports",
      "nav": {
        "parent": "reporting",
        "label": "Subscription reports"
      },
      "sort": {
        "date_created": "desc"
      },
      "fields": [
        {
          "id": "period_label",
          "label": "Period"
        },
        {
          "id": "active_count",
          "label": "Active"
        },
        {
          "id": "monthly_recurring_revenue",
          "label": "Monthly revenue"
        },
        {
          "id": "new_count",
          "label": "New"
        },
        {
          "id": "canceled_count",
          "label": "Canceled"
        },
        {
          "id": "net_change",
          "label": "Net"
        },
        {
          "id": "date_created",
          "label": "Generated"
        }
      ],
      "actions": [
        {
          "id": "new",
          "hidden": true
        }
      ]
    },
    {
      "id": "edit",
      "title": "{{ period_label }}",
      "fields": [
        {
          "id": "summary"
        },
        {
          "id": "plans"
        },
        {
          "id": "canceled_subscriptions"
        },
        {
          "id": "past_due_subscriptions"
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "period_start",
              "admin_span": 2
            },
            {
              "id": "period_end",
              "admin_span": 2
            }
          ]
        }
      ],
      "actions": [
        {
          "id": "save",
          "hidden": true
        }
      ]
    }
  ]
}
