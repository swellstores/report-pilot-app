{
  "$schema": "https://json.swell.store/notification.json",
  "collection": "customerreports",
  "label": "Customer report",
  "description": "Emails the customer activity summary to the recipients listed in the Report Pilot app settings each time a report is generated.",
  "method": "email",
  "event": "created",
  "enabled": true,
  "admin": true,
  "new": true,
  "repeat": true,
  "subject": "Customer report: {{ period_label }}",
  "conditions": { "id": { "$exists": false } },
  "fields": [
    {
      "id": "intro",
      "label": "Intro line",
      "type": "short_text",
      "default": "Here's who bought from the store."
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "long_text",
      "default": "You're receiving this because a store admin added your address to the Report Pilot app settings. To change how often you get the customer report, or to stop getting it, ask them to update those settings."
    }
  ],
  "sample": {
    "period_label": "Oct 5 – Oct 11, 2026",
    "period_start": "2026-10-05T00:00:00.000Z",
    "period_end": "2026-10-12T00:00:00.000Z",
    "currency": "USD",
    "customer_count": 98,
    "prev_customer_count": 87,
    "customer_change_pct": 12.64,
    "new_customer_count": 46,
    "returning_customer_count": 52,
    "repeat_buyer_count": 14,
    "repeat_rate_pct": 14.29,
    "returning_rate_pct": 53.06,
    "average_spend": 159.57,
    "truncated": false,
    "top_customers": [
      {
        "account_id": "8001",
        "name": "Ada Lovelace",
        "orders": 3,
        "spend": 912.4,
        "lifetime_value": 2410.75,
        "lifetime_orders": 11,
        "is_new": false
      },
      {
        "account_id": "8002",
        "name": "Grace Hopper",
        "orders": 1,
        "spend": 499.99,
        "lifetime_value": 499.99,
        "lifetime_orders": 1,
        "is_new": true
      },
      {
        "account_id": "8003",
        "name": "Alan Turing",
        "orders": 2,
        "spend": 331.2,
        "lifetime_value": 1022.0,
        "lifetime_orders": 6,
        "is_new": false
      }
    ]
  }
}
