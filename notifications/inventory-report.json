{
  "$schema": "https://json.swell.store/notification.json",
  "collection": "inventoryreports",
  "label": "Inventory report",
  "description": "Emails the out-of-stock and low-stock report to the recipients listed in the Report Pilot app settings each time a snapshot is taken.",
  "method": "email",
  "event": "created",
  "enabled": true,
  "admin": true,
  "new": true,
  "repeat": true,
  "subject": "Inventory report: {{ period_label }}",
  "conditions": { "id": { "$exists": false } },
  "fields": [
    {
      "id": "intro",
      "label": "Intro line",
      "type": "short_text",
      "default": "Here's what needs restocking."
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "long_text",
      "default": "You're receiving this because a store admin added your address to the Report Pilot app settings. To change how often you get the inventory report, or to stop getting it, ask them to update those settings."
    }
  ],
  "sample": {
