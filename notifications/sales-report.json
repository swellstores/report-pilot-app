{
  "$schema": "https://json.swell.store/notification.json",
  "collection": "reports",
  "label": "Sales report",
  "description": "Emails the sales and revenue summary to the recipients listed in the Report Pilot app settings each time a report is generated.",
  "method": "email",
  "event": "created",
  "enabled": true,
  "admin": true,
  "new": true,
  "repeat": true,
  "subject": "Sales report: {{ period_label }}",
  "conditions": { "id": { "$exists": false } },
  "fields": [
    {
      "id": "intro",
      "label": "Intro line",
      "type": "short_text",
      "default": "Here's how the store performed."
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "long_text",
      "default": "You're receiving this because a store admin added your address to the Report Pilot app settings. To change how often you get the sales report, or to stop getting it, ask them to update those settings."
    }
  ],
  "sample": {
    "period_label": "Aug 17 – Aug 23, 2026",
    "period_start": "2026-08-17T00:00:00.000Z",
    "period_end": "2026-08-24T00:00:00.000Z",
