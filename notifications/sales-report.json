    "prev_order_count": 111,
    "prev_grand_total": 13890.4,
    "revenue_change_pct": 11.07,
    "order_change_pct": 15.32,
    "top_products": [
      {
        "product_id": "6001",
        "name": "Merino Crew Sweater",
        "quantity": 38,
        "revenue": 3420
      },
      {
        "product_id": "6002",
        "name": "Canvas Weekender Bag",
