{
  "$schema": "https://json.swell.store/notification.json",
  "collection": "productreports",
  "label": "Product report",
  "description": "Emails the product summary to the recipients listed in the Report Pilot app settings each time a report is generated.",
  "method": "email",
  "event": "created",
  "enabled": true,
  "admin": true,
  "new": true,
  "repeat": true,
  "subject": "Products: {{ period_label }} — {{ products_sold_count }} sold, {{ unsold_count }} with no sales",
  "conditions": { "id": { "$exists": false } },
  "fields": [
    {
      "id": "intro",
      "label": "Intro line",
      "type": "short_text",
      "default": "Here's how your products performed."
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "long_text",
      "default": "You're receiving this because your address is listed as a recipient in the Report Pilot app settings. Change how often the product report is sent, turn it off, or remove your address there."
    }
  ],
